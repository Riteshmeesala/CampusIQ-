{
  "info": {
    "name": "CampusIQ+ Microservices (via API Gateway)",
    "_postman_id": "c7a8b9f0-1234-4567-89ab-cdef01234567",
    "description": "Complete Postman collection to test all microservice endpoints routed through Spring Cloud API Gateway (Port 8080).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "gatewayUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "adminToken",
      "value": "campusiq_jwt_token_admin",
      "type": "string"
    },
    {
      "key": "facultyToken",
      "value": "campusiq_jwt_token_faculty",
      "type": "string"
    },
    {
      "key": "studentToken",
      "value": "campusiq_jwt_token_student",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "0. Gateway & Actuator",
      "item": [
        {
          "name": "Gateway Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gatewayUrl}}/actuator/health",
              "host": ["{{gatewayUrl}}"],
              "path": ["actuator", "health"]
            }
          }
        },
        {
          "name": "Gateway Dynamic Routes",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gatewayUrl}}/actuator/gateway/routes",
              "host": ["{{gatewayUrl}}"],
              "path": ["actuator", "gateway", "routes"]
            }
          }
        }
      ]
    },
    {
      "name": "1. Auth Service (:8081)",
      "item": [
        {
          "name": "Auth - Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin@campusiq.edu.in\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{gatewayUrl}}/api/auth/login",
              "host": ["{{gatewayUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "Users - Stats",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": {
              "raw": "{{gatewayUrl}}/api/users/stats",
              "host": ["{{gatewayUrl}}"],
              "path": ["api", "users", "stats"]
            }
          }
        },
        {
          "name": "Users - List Students",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": {
              "raw": "{{gatewayUrl}}/api/users/students",
              "host": ["{{gatewayUrl}}"],
              "path": ["api", "users", "students"]
            }
          }
        },
        {
          "name": "Users - List Faculty",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": {
              "raw": "{{gatewayUrl}}/api/users/faculty",
              "host": ["{{gatewayUrl}}"],
              "path": ["api", "users", "faculty"]
            }
          }
        },
        {
          "name": "Registrations - Stats",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": {
              "raw": "{{gatewayUrl}}/api/registrations/stats",
              "host": ["{{gatewayUrl}}"],
              "path": ["api", "registrations", "stats"]
            }
          }
        }
      ]
    },
    {
