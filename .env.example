# =====================================================================
# CampusIQ+ Production Environment Variables Template
# VARIABLE NAMES ONLY — NEVER PUT REAL PASSWORDS OR KEYS IN THIS FILE
# =====================================================================

# ── DATABASE CONFIGURATION (Aiven MySQL / Cloud Database) ──
# Option A: Full JDBC URL (Recommended for Aiven with SSL)
# Format: jdbc:mysql://<HOST>:<PORT>/<DATABASE_NAME>?useSSL=true&serverTimezone=UTC&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_URL=

# Option B: Individual connection parameters
DB_HOST=
DB_PORT=
DB_NAME=
DB_USERNAME=
DB_PASSWORD=
DB_SSL=true
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# ── EUREKA SERVICE REGISTRY ──
EUREKA_SERVER_URL=
EUREKA_INSTANCE_HOSTNAME=

# ── API GATEWAY INTER-SERVICE ROUTING (Optional when Eureka is used) ──
AUTH_SERVICE_URL=
ACADEMIC_SERVICE_URL=
ASSESSMENT_SERVICE_URL=
FINANCE_SERVICE_URL=
CAMPUS_AI_SERVICE_URL=

# ── SECURITY & JWT AUTHENTICATION ──
JWT_SECRET=
JWT_EXPIRATION=
JWT_REFRESH_EXPIRATION=

# ── CORS & FRONTEND URL ──
FRONTEND_URL=
CORS_ORIGINS=

# ── CAMPUS AI / LLM CONFIGURATION ──
GROK_API_KEY=
XAI_API_KEY=
GROK_MODEL=
GROK_BASE_URL=

# ── EMAIL / SMTP NOTIFICATIONS (OPTIONAL) ──
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# ── PAYMENT GATEWAY (RAZORPAY - OPTIONAL) ──
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ── FRONTEND (VERCEL) ──
REACT_APP_API_BASE_URL=
